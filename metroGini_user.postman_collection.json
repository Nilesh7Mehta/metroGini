              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"pickup_date\": \"2026-03-19\",\r\n  \"pickup_slot_id\": 2\r\n}\r\n\r\n",
