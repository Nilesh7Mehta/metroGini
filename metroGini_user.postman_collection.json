    {
      "name": "2. Create order",
      "item": [
        {
          "name": "1. Create Order (Draft)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"service_id\": 1,\r\n    \"clothes_count\": 10\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/order",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order"
              ]
            },
            "description": "Creates/updates a draft. Clothes count must be 10–25. Uses the user’s selected default address. Saves {{orderId}} on success."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const id = json.id || (json.data && json.data.id);",
                  "  if (id) pm.collectionVariables.set(\"orderId\", String(id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Update Service Type",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"service_type_id\": 1\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/service-type",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
                "service-type"
              ]
            },
            "description": "Step-by-step path. Skip this if you use Complete Order instead."
          },
          "response": []
        },
        {
