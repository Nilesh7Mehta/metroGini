{
  "info": {
    "_postman_id": "0ab27996-6701-4140-840f-dcf18b76748a",
    "name": "metroGini_user",
    "description": "User login + order journey.\n\nLogin: Login Or Register → Verify OTP (saves `token` and `refreshToken`).\nAddress: Add Address (required) → Set Default if needed → Create Order.\nOrder: Create Order (saves `orderId`) → Complete Order → Review (auto loyalty coupon) → Payment → Order Details.\nLoyalty: Review auto-applies coupon marked `auto_apply_loyalty` (percentage for 1st-2nd orders, per_kg for 3rd+). Remove to dismiss; Apply with `{}` to reapply.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "1. Login Or Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"mobile\": \"{{mobile}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/login-or-register",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "login-or-register"
              ]
            },
            "description": "Sends OTP to the mobile. OTP is currently 1234. Response includes profile_completed and terms_and_condition."
          },
          "response": []
        },
        {
          "name": "2. Resend OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"mobile\": \"{{mobile}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/resend-otp",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "resend-otp"
              ]
            },
            "description": "Optional. Same body as login-or-register."
          },
          "response": []
        },
        {
          "name": "3. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || json;",
                  "  if (data.access_token) pm.collectionVariables.set(\"token\", data.access_token);",
                  "  if (data.refresh_token) pm.collectionVariables.set(\"refreshToken\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"mobile\": \"{{mobile}}\",\r\n    \"otp\": \"1234\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/verify-otp",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "verify-otp"
              ]
            },
            "description": "Saves token to {{token}} and {{refreshToken}}. terms_and_condition is set true automatically on verify."
          },
          "response": []
        },
        {
          "name": "4. Get Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}api/user/profile",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "profile"
              ]
            },
            "description": "Confirms login. Requires {{token}} from Verify OTP."
          },
          "response": []
        },
        {
          "name": "5. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const access = json.access_token || (json.data && json.data.access_token);",
                  "  if (access) pm.collectionVariables.set(\"token\", access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"refresh_token\": \"{{refreshToken}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/refresh-token",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "refresh-token"
              ]
            },
            "description": "Uses {{refreshToken}} from Verify OTP and updates {{token}}."
          },
          "response": []
        },
        {
          "name": "6. Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"refresh_token\": \"{{refreshToken}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/logout",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "logout"
              ]
            },
            "description": "Invalidates {{refreshToken}}. Run this last, after the order journey."
          },
          "response": []
        }
      ]
    },
