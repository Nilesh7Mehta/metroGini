        {
          "name": "4. Update Delivery",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"delivery_date\": \"2026-03-22\",\r\n  \"delivery_slot_id\": 2\r\n}\r\n\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/delivery",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
                "delivery"
              ]
            },
            "description": "Step-by-step path. Skip this if you use Complete Order instead."
          },
          "response": []
        },
        {
          "name": "5. Update Instructions",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_special_instruction\": \"Leave at gate\",\n  \"delivery_special_instruction\": \"Call on arrival\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/instructions",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
                "instructions"
              ]
            },
            "description": "Save pickup/delivery special instructions.\n\nBody (at least one required):\n- pickup_special_instruction\n- delivery_special_instruction"
          },
          "response": []
        },
        {
          "name": "6. Complete Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"service_type_id\": 1,\r\n  \"pickup_date\": \"2026-06-05\",\r\n  \"pickup_slot_id\": 2\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/complete-order",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
                "complete-order"
              ]
            },
            "description": "One-shot: service type + pickup + auto delivery (+3 days) + finalize. Preferred over steps 2–4 + Finalize."
          },
          "response": []
        },
        {
          "name": "6b. Finalize (if not using Complete Order)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/finalize",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
                "finalize"
              ]
            },
            "description": "Use only if you set service type, pickup, and delivery yourself instead of Complete Order."
          },
          "response": []
        },
        {
          "name": "7. Review Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Auto-applies loyalty coupon on estimate from coupons table (`auto_apply_loyalty=true`): percentage for 1st-2nd completed orders, per_kg for 3rd+. Skips if user dismissed on this draft.",
            "url": {
              "raw": "{{baseUrl}}api/user/order/{{orderId}}/review",
              "host": [
                "{{baseUrl}}api"
              ],
              "path": [
                "user",
                "order",
                "{{orderId}}",
